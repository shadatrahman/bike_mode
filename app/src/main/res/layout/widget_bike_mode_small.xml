<?xml version="1.0" encoding="utf-8"?>
<!-- Square form (roughly 2x2). State as the hero, direction underneath it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_off"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_bike_mode" />

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.22"
        android:maxLines="1"
        android:text="@string/widget_label"
        android:textColor="@color/widget_foreground_dim"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.16"
        android:maxLines="1"
        android:text="@string/widget_state_off"
        android:textColor="@color/widget_foreground"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_direction_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/widget_direction_locks_right"
            android:src="@drawable/ic_direction_right" />

        <TextView
            android:id="@+id/widget_direction_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:text="@string/widget_direction_locks_right"
            android:textColor="@color/widget_foreground_dim"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
