<?xml version="1.0" encoding="utf-8"?>
<!-- One-row form (roughly 2x1). Glyph plus state, nothing else fits honestly. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_off"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_bike_mode" />

    <TextView
        android:id="@+id/widget_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:letterSpacing="0.18"
        android:maxLines="1"
        android:text="@string/widget_state_off"
        android:textColor="@color/widget_foreground"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
