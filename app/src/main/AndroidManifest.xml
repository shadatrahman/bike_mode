<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sole special permission: used only to toggle auto-rotate and pin screen orientation. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Keeps the rotation watchdog resident while Bike Mode is on, and only then. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Rotation settings survive a reboot; the watchdog has to be put back to match. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only ever used for the ongoing "Bike Mode on" status and its off switch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Used only to see whether Bluetooth is off and to show the system's own "turn it on?" dialog.
        The app never scans for, pairs with or talks to a device, so it never asks to locate one.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BikeMode">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BikeMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.BikeModeWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bike_mode_widget_info" />
        </receiver>

        <!--
            Invisible host for the system Bluetooth dialog, so the tile and the widget can raise it
            too. Its own task, kept out of recents: it is a dialog, not a screen.
        -->
        <activity
            android:name=".bluetooth.BluetoothRequestActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Re-arms the watchdog after a reboot or an app update. -->
        <receiver
            android:name=".system.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Woken by the system only when a rotation setting changes; the recovery path. -->
        <service
            android:name=".rotation.RotationWatchdogJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
            Runs only while Bike Mode is on. No wake lock, no sensors, no network, no polling: it
            sleeps on a ContentObserver, so residency is its whole cost.
        -->
        <service
            android:name=".rotation.RotationWatchdogService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds the rider's landscape lock while Bike Mode is on, re-applying it the moment another app rewrites the system rotation setting." />
        </service>

        <service
            android:name=".quicksettings.BikeModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_bike_mode"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>

</manifest>
